{
  "name": "APK TV Converter AI Studio",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8877],
  "portsAttributes": {
    "8877": {
      "label": "APK TV Converter Web Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "./setup_tools.sh && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
